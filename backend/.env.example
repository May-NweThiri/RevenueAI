# === App ===
APP_NAME=FinX AI
DEBUG=false

# === Database (Supabase PostgreSQL) ===
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.supabase.co:6543/postgres?sslmode=require

# === Storage Backend ===
# "local" for development, "supabase" for production
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=52428800

# === Supabase (required when STORAGE_BACKEND=supabase) ===
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=revenueai-uploads

# === AI provider (optional — fallback to local templates when neither is set) ===
# Gemini has a free tier: get a key at https://aistudio.google.com/apikey
# If both keys are set, Gemini is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.3

# === CORS ===
CORS_ORIGINS=http://localhost:3000,https://YOUR_APP.vercel.app
